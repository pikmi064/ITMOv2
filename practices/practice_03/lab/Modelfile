# Профиль для прямого чата и API: небольшой контекст, встроенная инструкция.
# База: qwen3.5:4b (4.5B, nvfp4, ~4 GB) - подходит под 16 GB унифицированной памяти (Apple M4).
FROM qwen3.5:4b
# 4096 токенов хватает на demo/README.md + вопрос и почти не раздувает KV-cache.
PARAMETER num_ctx 4096
# Низкая температура: ответы по фактам, меньше случайных выдумок.
PARAMETER temperature 0.2
# Фиксированный seed: прогоны воспроизводимы.
PARAMETER seed 42
# Ограничение длины ответа, чтобы модель не уходила в длинные рассуждения.
PARAMETER num_predict 512
SYSTEM """Ты помощник по учебному проекту. Отвечай по предоставленным фактам.
Если данных нет, напиши «В предоставленных материалах нет ответа».
Не выдумывай файлы и настройки. Дай короткий ответ и основание."""
