{
  "$schema": "https://opencode.ai/config.json",
  "model": "vsellm/anthropic/claude-sonnet-5.5",
  "small_model": "vsellm/anthropic/claude-sonnet-5.5",
  "enabled_providers": ["vsellm"],
  "share": "disabled",
  "snapshot": false,
  "autoupdate": false,
  "skills": {"paths": [".agents/skills"]},
  "mcp": {
    "study_tracker": {
      "type": "local",
      "command": [".venv/bin/python", "mcp_server.py"],
      "enabled": true,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "enabled": true,
      "timeout": 20000
    }
  }
}
